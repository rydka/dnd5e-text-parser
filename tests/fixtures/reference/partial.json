{
  "_comment": "Partially filled objects for mergeMissing (L5, importer M5). Truth annotated by hand before any run. For each case: target (input), patch, options (optional), expected (target after the merge), filled (paths filled by the merge, dotted, array = leaf). A leaf is 'empty' per isEmpty(): undefined, null, '', [], {}; 0 and false are NOT empty unless listed in options.zeroIsEmpty. A patch leaf that is itself empty is never reported. Every non-empty leaf of the input must be identical in the output.",
  "cases": [
    { "id": "p01-attack-without-damage", "target": { "attack": { "bonus": "5", "flat": true }, "damage": { "parts": [] } }, "patch": { "attack": { "bonus": "8", "flat": true }, "damage": { "parts": [ { "number": 1, "denomination": 4, "bonus": "4", "types": ["bludgeoning"] } ] } }, "expected": { "attack": { "bonus": "5", "flat": true }, "damage": { "parts": [ { "number": 1, "denomination": 4, "bonus": "4", "types": ["bludgeoning"] } ] } }, "filled": ["damage.parts"] },
    { "id": "p02-save-without-dc", "target": { "save": { "ability": ["wis"], "dc": { "calculation": "", "formula": "" } } }, "patch": { "save": { "ability": ["con"], "dc": { "formula": "13" } } }, "expected": { "save": { "ability": ["wis"], "dc": { "calculation": "", "formula": "13" } } }, "filled": ["save.dc.formula"] },
    { "id": "p03-different-bonus-kept", "target": { "attack": { "bonus": "3" } }, "patch": { "attack": { "bonus": "6" } }, "expected": { "attack": { "bonus": "3" } }, "filled": [] },
    { "id": "p04-custom-kept", "target": { "traits": { "dr": { "custom": "special" } } }, "patch": { "traits": { "dr": { "custom": "other" } } }, "expected": { "traits": { "dr": { "custom": "special" } } }, "filled": [] },
    { "id": "p05-empty-target", "target": {}, "patch": { "range": { "value": 5, "units": "ft" }, "target": { "affects": { "count": "1", "type": "creature" } } }, "expected": { "range": { "value": 5, "units": "ft" }, "target": { "affects": { "count": "1", "type": "creature" } } }, "filled": ["range.value", "range.units", "target.affects.count", "target.affects.type"] },
    { "id": "p06-partly-filled-range", "target": { "range": { "value": 30, "units": "" } }, "patch": { "range": { "value": 5, "units": "ft" } }, "expected": { "range": { "value": 30, "units": "ft" } }, "filled": ["range.units"] },
    { "id": "p07-zero-is-filled-by-default", "target": { "uses": { "max": 0 } }, "patch": { "uses": { "max": 3 } }, "expected": { "uses": { "max": 0 } }, "filled": [] },
    { "id": "p08-zero-is-empty-option", "target": { "uses": { "max": 0 } }, "patch": { "uses": { "max": 3 } }, "options": { "zeroIsEmpty": ["uses.max"] }, "expected": { "uses": { "max": 3 } }, "filled": ["uses.max"] },
    { "id": "p09-false-kept", "target": { "flat": false }, "patch": { "flat": true }, "expected": { "flat": false }, "filled": [] },
    { "id": "p10-null-type-filled-value-kept", "target": { "activation": { "type": null, "value": 1 } }, "patch": { "activation": { "type": "action", "value": 2 } }, "expected": { "activation": { "type": "action", "value": 1 } }, "filled": ["activation.type"] },
    { "id": "p11-empty-object-filled", "target": { "a": {} }, "patch": { "a": { "b": 1 } }, "expected": { "a": { "b": 1 } }, "filled": ["a.b"] },
    { "id": "p12-nonempty-array-kept", "target": { "damage": { "parts": [ { "number": 2 } ] } }, "patch": { "damage": { "parts": [ { "number": 1, "denomination": 6 } ] } }, "expected": { "damage": { "parts": [ { "number": 2 } ] } }, "filled": [] },
    { "id": "p13-empty-string-filled", "target": { "name": "" }, "patch": { "name": "Slam" }, "expected": { "name": "Slam" }, "filled": ["name"] },
    { "id": "p14-empty-patch-ignored", "target": { "x": { "y": "" } }, "patch": { "x": { "y": "" } }, "expected": { "x": { "y": "" } }, "filled": [] },
    { "id": "p15-template-absent", "target": {}, "patch": { "template": { "type": "cone", "size": "15" } }, "expected": { "template": { "type": "cone", "size": "15" } }, "filled": ["template.type", "template.size"] },
    { "id": "p16-utility-activation-kept", "target": { "type": "utility", "activation": { "type": "action", "value": 1 }, "roll": { "formula": "" } }, "patch": { "activation": { "type": "bonus", "value": 3 }, "roll": { "formula": "1d4+4" } }, "expected": { "type": "utility", "activation": { "type": "action", "value": 1 }, "roll": { "formula": "1d4+4" } }, "filled": ["roll.formula"] },
    { "id": "p17-uses-recovery-both-empty", "target": { "uses": { "max": "", "recovery": [] } }, "patch": { "uses": { "max": "3", "recovery": [ { "period": "day", "type": "recoverAll" } ] } }, "expected": { "uses": { "max": "3", "recovery": [ { "period": "day", "type": "recoverAll" } ] } }, "filled": ["uses.max", "uses.recovery"] },
    { "id": "p18-recovery-kept", "target": { "uses": { "max": "", "recovery": [ { "period": "sr", "type": "recoverAll" } ] } }, "patch": { "uses": { "max": "1", "recovery": [ { "period": "day", "type": "recoverAll" } ] } }, "expected": { "uses": { "max": "1", "recovery": [ { "period": "sr", "type": "recoverAll" } ] } }, "filled": ["uses.max"] },
    { "id": "p19-path-prefix", "target": { "range": { "value": "" } }, "patch": { "range": { "value": 5 } }, "options": { "path": "system.activities.a" }, "expected": { "range": { "value": 5 } }, "filled": ["system.activities.a.range.value"] },
    { "id": "p20-deep-kept-and-filled", "target": { "a": { "b": { "c": "x" } } }, "patch": { "a": { "b": { "c": "y", "d": "z" } } }, "expected": { "a": { "b": { "c": "x", "d": "z" } } }, "filled": ["a.b.d"] }
  ]
}
