{
  "id": "dnd5e-text-parser",
  "title": "dnd5e Text Parser",
  "description": "Shared library that parses dnd5e stat block and item text (English and French) into dnd5e 5.3 data (Foundry v13 branch).",
  "version": "1.1.0-v13",
  "authors": [
    {
      "name": "Rydka"
    }
  ],
  "compatibility": {
    "minimum": "13",
    "verified": "13"
  },
  "relationships": {
    "systems": [
      {
        "id": "dnd5e",
        "type": "system",
        "compatibility": {
          "minimum": "5.3.0",
          "verified": "5.3.3",
          "maximum": "5.99"
        }
      }
    ]
  },
  "esmodules": [
    "scripts/module.mjs"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "fr",
      "name": "Français",
      "path": "lang/fr.json"
    }
  ],
  "url": "https://github.com/rydka/dnd5e-text-parser",
  "manifest": "https://raw.githubusercontent.com/rydka/dnd5e-text-parser/v13/module.json",
  "download": "https://github.com/rydka/dnd5e-text-parser/releases/download/v1.1.0-v13/module.zip",
  "bugs": "https://github.com/rydka/dnd5e-text-parser/issues",
  "library": true
}
